            ws.Cell("I$filaActual}").Value = "Alta";
            ws.Cell("J$filaActual}").Value = "Días";
            ws.Cell("K$filaActual}").Value = "Pagar";

            ws.Range($"L$filaActual:P$filaActual").Merge();
